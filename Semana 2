class Estudiante:

    def __init__(self, nombre, nota1, nota2, nota3):
        self.__nombre = nombre
        self.__nota1 = nota1
        self.__nota2 = nota2
        self.__nota3 = nota3

    def get_nombre(self):
        return self.__nombre

    def get_nota1(self):
        return self.__nota1

    def get_nota2(self):
        return self.__nota2

    def get_nota3(self):
        return self.__nota3


    def set_nombre(self, nombre):
        self.__nombre = nombre

    def set_nota1(self, nota1):
        self.__nota1 = nota1

    def set_nota2(self, nota2):
        self.__nota2 = nota2

    def set_nota3(self, nota3):
        self.__nota3 = nota3

    def calcular_promedio(self):
        return (self.__nota1 + self.__nota2 + self.__nota3) / 3


class Universidad:

    def __init__(self, nombre):
        self.__nombre = nombre

    def get_nombre(self):
        return self.__nombre

    def set_nombre(self, nombre):
        self.__nombre = nombre


class EstudianteUniversitario(Estudiante):

    def __init__(self, nombre, nota1, nota2, nota3, universidad):
        super().__init__(nombre, nota1, nota2, nota3)
        self.__universidad = universidad

    def mostrar_informacion(self):
        promedio = self.calcular_promedio()

        print(" RESULTADO")
        print("Nombre:", self.get_nombre())
        print("Universidad:", self.__universidad.get_nombre())
        print("Nota 1:", self.get_nota1())
        print("Nota 2:", self.get_nota2())
        print("Nota 3:", self.get_nota3())
        print("Promedio:", promedio)

        if promedio > 7:
            print("Estado: Aprobaste")
        else:
            print("Estado: Reprobaste")


nombre = input("nombre: ")
universidad = input("universidad: ")
nota1 = float(input("nota 1: "))
nota2 = float(input("nota 2: "))
nota3 = float(input("nota 3: "))

universidad1 = Universidad(universidad)

estudiante1 = EstudianteUniversitario(
    nombre,
    nota1,
    nota2,
    nota3,
    universidad1
)

estudiante1.mostrar_informacion()
